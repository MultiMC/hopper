#!/bin/bash -eu
# Release the translations to a files tree: the Translations repo's TRANSLATIONS_BRANCH at
# $COMMIT (default: its head), with hopper's own scripts and the settings named by the
# job's name (translations-production: config/production.env, translations-files2:
# config/files2.env), as hopper did before those settings files handed the stream to
# Laminar (HOPPER_HANDED_OFF). Each job's .run is a link to this file.
#
#   translations/build.py        the release, in RELEASES_DIR/translations-<time>-<commit>
#   files/deploy.py              into the local files tree (FILES_ROOT), after a snapshot of it
#   files/publish.py             what changed: the live tree, the bucket, Cloudflare's cache
#   daemon/releases.py cleanup   housekeeping; a failure is only logged
#
# The release stays in RELEASES_DIR (its cleanup keeps the newest); its path, manifest.json
# and release.log go to $ARCHIVE.
#
#     laminarc queue translations-<production|files2> [COMMIT=<sha>]

config=config/${JOB#translations-}.env
# hopper's scripts stop at once when another one holds a lock they need (a release build,
# the files tree); nothing retries a Laminar job, so they wait for it instead
export HOPPER_LOCK_WAIT=3600

# This file is in the hopper checkout's laminar/cfg/scripts (~/laminar/cfg is a link to it)
cd "$(dirname "$(realpath "$0")")/../../.."
status=0
release=$(translations/build.py --config "$config" ${COMMIT:+"$COMMIT"}) || status=$?
if [[ -n $release ]]; then
    echo "$release" > "$ARCHIVE/release"
    cp "$release/manifest.json" "$release/release.log" "$ARCHIVE/" 2>/dev/null || true
fi
if (( status )); then
    echo "the build failed, nothing deployed" >&2
    exit "$status"
fi

files/deploy.py --config "$config" "$release"
files/publish.py --config "$config"
daemon/releases.py --config "$config" cleanup || echo "the release cleanup failed (housekeeping only)" >&2
