#!/bin/bash -eu
# One of hopper's streams or scheduled jobs, released the way hopper did it before the
# settings file handed it to Laminar (HOPPER_HANDED_OFF). The job's name says which, and
# with which settings: <stream>-<setup>, e.g. translations-files2 is the translations with
# config/files2.env. Each such job's .run is a link to this file. The same scripts as
# hopper's, in the same order:
#
#   launcher      launcher/release-build.py [$COMMIT], files/deploy.py, files/publish.py
#   translations  translations/build.py [$COMMIT], files/deploy.py, files/publish.py
#   patrons       patrons/update.py, files/deploy.py, files/publish.py
#   website       website/build.py [$COMMIT], website/publish.py (to test; production is
#                 promoted by hand: website/publish.py --production)
#
# then daemon/releases.py cleanup (housekeeping; a failure is only logged). $COMMIT
# defaults to the head of the branch. The release stays in RELEASES_DIR (its cleanup keeps
# the newest); its path, manifest.json and build logs (the launcher's: one per platform,
# and its compatibility reports) go to $ARCHIVE.
#
#     laminarc queue <job> [COMMIT=<sha>]

stream=${JOB%-*}
config=config/${JOB##*-}.env
# hopper's scripts stop at once when another one holds a lock they need (a release build,
# the files tree); nothing retries a Laminar job, so they wait for it instead
export HOPPER_LOCK_WAIT=3600

# This file is in the hopper checkout's laminar/cfg/scripts (~/laminar/cfg is a link to it)
cd "$(dirname "$(realpath "$0")")/../../.."
[[ -f $config ]] || { echo "no settings file $config for job $JOB" >&2; exit 1; }

case $stream in
    launcher)     build=(launcher/release-build.py --config "$config" ${COMMIT:+"$COMMIT"}) ;;
    translations) build=(translations/build.py --config "$config" ${COMMIT:+"$COMMIT"}) ;;
    website)      build=(website/build.py --config "$config" ${COMMIT:+"$COMMIT"}) ;;
    patrons)      build=(patrons/update.py --config "$config") ;;
    *)            echo "no stream $stream (job $JOB)" >&2; exit 1 ;;
esac

status=0
release=$("${build[@]}") || status=$?
if [[ -n $release ]]; then
    echo "$release" > "$ARCHIVE/release"
    for file in "$release"/{manifest.json,release.log,hugo.log,build-*.log,compat-*.txt}; do
        if [[ -f $file ]]; then cp "$file" "$ARCHIVE/"; fi
    done
fi
if (( status )); then
    echo "the build failed, nothing published" >&2
    exit "$status"
fi

if [[ $stream == website ]]; then
    website/publish.py --config "$config" "$release"
else
    files/deploy.py --config "$config" "$release"
    files/publish.py --config "$config"
fi
daemon/releases.py --config "$config" cleanup || echo "the release cleanup failed (housekeeping only)" >&2
