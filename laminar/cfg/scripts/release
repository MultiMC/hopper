#!/bin/bash -eu
# A release of one of hopper's streams. The job's name says which, and with which settings:
# <stream>-<setup>, e.g. translations-files2 is the translations with config/files2.env.
# Each such job's .run is a link to this file. It runs hopper's scripts, in this order:
#
#   launcher      launcher/release-build.py --incremental [$COMMIT], updater/deploy.py (the new
#                 updater's tree), updater/update-test.py (the new Latest goes back to Stable
#                 and up again; when it can't, the tree is restored to before it and the job
#                 fails, so the build is never published), updater/prune.py (its size cap),
#                 files/publish.py
#   translations  translations/build.py [$COMMIT], files/deploy.py, files/publish.py
#   patrons       patrons/update.py, files/deploy.py, files/publish.py
#   packages      packages/build.py [$COMMIT], files/deploy.py (only a version not published
#                 yet), files/publish.py, packages/aur.py (when that release deployed it; no
#                 AUR key: skipped)
#   website       website/build.py [$COMMIT], website/publish.py (to test; production is
#                 promoted by hand: website/publish.py --production)
#
# Launcher builds go into the new updater's tree only; the old update layout took its last
# build at the cutover (files/deploy.py refuses them, files/publish.py refuses changes to it).
# A setup without the new tree (UPDATER_ROOT empty) skips it with a log line (--if-configured).
#
# then daemon/releases.py cleanup (housekeeping; a failure is only logged). After a
# published launcher-production, it queues template-production (the translations template)
# for the same commit; a failure to queue is only logged. $COMMIT
# defaults to the head of the branch. The release stays in RELEASES_DIR (its cleanup keeps
# the newest); its path, manifest.json and build logs (the launcher's: one per platform,
# and its compatibility reports) go to $ARCHIVE.
#
#     laminarc queue <job> [COMMIT=<sha>]

stream=${JOB%-*}
config=config/${JOB##*-}.env
# hopper's scripts stop at once when another one holds a lock they need (a release build,
# the files tree); nothing retries a Laminar job, so they wait for it instead
export HOPPER_LOCK_WAIT=3600

# This file is in the hopper checkout's laminar/cfg/scripts (~/laminar/cfg is a link to it)
cd "$(dirname "$(realpath "$0")")/../../.."
[[ -f $config ]] || { echo "no settings file $config for job $JOB" >&2; exit 1; }

case $stream in
    # incremental in the setup's WORK_DIR; launcher/verify-build.py checks it against clean builds
    launcher)     build=(launcher/release-build.py --config "$config" --incremental ${COMMIT:+"$COMMIT"}) ;;
    translations) build=(translations/build.py --config "$config" ${COMMIT:+"$COMMIT"}) ;;
    website)      build=(website/build.py --config "$config" ${COMMIT:+"$COMMIT"}) ;;
    patrons)      build=(patrons/update.py --config "$config") ;;
    packages)     build=(packages/build.py --config "$config" ${COMMIT:+"$COMMIT"}) ;;
    *)            echo "no stream $stream (job $JOB)" >&2; exit 1 ;;
esac

status=0
release=$("${build[@]}") || status=$?
if [[ -n $release ]]; then
    echo "$release" > "$ARCHIVE/release"
    for file in "$release"/{manifest.json,release.log,hugo.log,build-*.log,compat-*.txt}; do
        if [[ -f $file ]]; then cp "$file" "$ARCHIVE/"; fi
    done
fi
if (( status )); then
    echo "the build failed, nothing published" >&2
    exit "$status"
fi

case $stream in
    website)
        website/publish.py --config "$config" "$release" ;;
    launcher)
        # one publish, after the update test: a build that fails it is never published
        updater/deploy.py --config "$config" --if-configured "$release"
        updater/update-test.py --config "$config" --if-configured --restore-on-failure
        updater/prune.py --config "$config" --if-configured
        files/publish.py --config "$config" ;;
    packages)
        # the AUR's PKGBUILD downloads the source tarball: pushed after it's live
        files/deploy.py --config "$config" "$release"
        files/publish.py --config "$config"
        packages/aur.py --config "$config" --if-configured "$release" ;;
    *)
        files/deploy.py --config "$config" "$release"
        files/publish.py --config "$config" ;;
esac
if [[ $JOB == launcher-production ]]; then
    # laminarc reaches laminard by LAMINAR_BIND_RPC, from laminar.service's environment
    LAMINAR_REASON="after $JOB:$RUN" "$LAMINAR_HOME/bin/laminarc" queue template-production ${COMMIT:+"COMMIT=$COMMIT"} \
        || echo "queueing template-production failed" >&2
fi
daemon/releases.py --config "$config" cleanup || echo "the release cleanup failed (housekeeping only)" >&2
