# The parallel test system: files2.multimc.org, set up like production. The files server
# serves the live tree (/home/http/files2, Caddy site files2.multimc.org); the R2 bucket
# multimc-files2 holds a copy, as production's bucket will, and serves it at
# files2-r2.multimc.org (custom domain, r2.dev off). Nothing else writes to it. Use with
# --config for every script.
#
# Builds made with this config use files2 and its copy only (FILES_MIRRORS), so they test
# the whole path without touching files.multimc.org.

FILES_ROOT=$STATE/files2
FILES_ORIGIN=root@deth001.multimc.org:/home/http/files2/
BUCKET_TARGET=r2:multimc-files2
FILES_MIRRORS="https://files2.multimc.org/ https://files2-r2.multimc.org/"
# The new updater's tree, signed with files2's test keys (made on the build server, in
# ~/keys/files2; see README). files2's Launchers use the new updater, pinned to those keys.
UPDATER_ROOT=updater
UPDATER_KEYS=$HOPPER/config/keys/files2
UPDATER_ONLINE_KEY=$HOME/keys/files2/online1.pem
UPDATER_VERSION=2
UPDATER_ROOT_KEYS="b00524fc7df69bd16e387f7aa16fafb503553acda51575e2f7e62ad6355f545a a81aaad40718fcb5b0fdf2918dd4a66d7b06db9ffac4a960ae61915952f5d568"
# Until the theming overhaul is tested here and merged into develop (2026-11-08); then back
# to develop, here and in laminar/cfg/jobs/launcher-files2.conf
LAUNCHER_BRANCH=theming
# files2 numbers its builds separately (seeded at 5002, its last build on 2026-10-23)
BUILD_COUNTER=$STATE/build-number-files2
RELEASES_DIR=$STATE/releases-files2
# The Patreon credits are production's only: one token, one machine
PATRONS_CONFIG=
# The website is production's only
WEBSITE_REPO=
