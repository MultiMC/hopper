// hopper's Zig programs: `zig build` puts them in zig-out/bin. Built with the Zig named here, and
// only that one: Zig still changes between releases.
.{
    .name = .hopper,
    .version = "0.0.1",
    .minimum_zig_version = "0.17.0",
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "lib",
        "daemon",
    },
    .fingerprint = 0xd7488b367aa2398f,
}
