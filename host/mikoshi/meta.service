# The meta pipeline (MultiMC/meta) on mikoshi, moved from deth001 as it was: its own
# update.sh, from its checkout in ~/meta, as the hopper user. Started hourly by meta.timer
# (deth001 ran it from root's crontab, `0 * * * *`).
#
# The run itself is Laminar's job `meta` (~/laminar/cfg/jobs/meta.run: update.sh, then the
# Forge maven copy to deth001), so every run, its log and its result are in Laminar. This
# unit only starts it and waits for it: `laminarc run` exits 0 when the run succeeded, 3 when
# it failed. Stopping this unit doesn't stop the run; `laminarc abort meta <run>` does.
#
#   systemctl --user link ~/hopper/host/mikoshi/meta.service ~/hopper/host/mikoshi/meta.timer
#   systemctl --user start meta.service      # one run now (or: laminarc queue meta)
#   systemctl --user enable --now meta.timer
#
# meta itself is unchanged; only its config/config_local.sh differs from deth001's:
# DEPLOY_FOLDER_master is root@deth001.multimc.org:/home/http/meta/v1/, so update.sh's own
# rsync deploys meta.multimc.org through hopper-ssh, and DEPLOY_FORGE_MAVEN=false (it only
# guarded a chown to http, which hopper can't do; the S3 sync behind it is off). The Forge
# maven copy that enumerateForge.py keeps in ~/forgemaven (the checkout's forgemaven
# symlink) is copied to deth001 afterwards, by the job, as it only grows: no deletes.

[Unit]
Description=MultiMC meta: Laminar's meta job (update.sh, then its Forge maven copy to deth001)
After=laminar.service
Requires=laminar.service

[Service]
Type=oneshot
Environment=LAMINAR_HOST=unix:%h/laminar/rpc.sock
ExecStart=%h/laminar/bin/laminarc run meta
